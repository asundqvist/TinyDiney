  client.test("Second page metadata", function () { client.assert(response.body.page === 1 && response.body.content.length <= 6); });
%}

### 12. Guest requests booking A — 201 + Location, reference and transition links
< {%
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  const day = tomorrow.getFullYear() + "-" + String(tomorrow.getMonth() + 1).padStart(2, "0") + "-" + String(tomorrow.getDate()).padStart(2, "0");
  request.variables.set("reservationTime", day + "T17:00:00");
%}
POST {{host}}/bookings
Authorization: Bearer {{guestToken}}
Content-Type: application/json
Accept: application/json

{
  "restaurantId": {{demoRestaurantId}},
  "customerName": "Demo Family A",
  "customerEmail": "demo.guest@example.com",
  "time": "{{reservationTime}}",
  "guests": 4
}

> {%
  client.test("HTTP 201", function () { client.assert(response.status === 201, "Expected 201, got " + response.status); });
  client.test("Created booking and legal links", function () {
    client.assert(response.headers.valueOf("Location").endsWith("/bookings/" + response.body.id));
    client.assert(response.body.status === "REQUESTED");
    client.assert(/^TD-[A-HJ-NP-Z2-9]{8}-[A-HJ-NP-Z2-9]{8}$/.test(response.body.reference));
    client.assert(!!response.body._links.confirm && !!response.body._links.cancel);
    client.assert(!response.body._links.seat);
  });
  if (response.status === 201) client.global.set("bookingAId", response.body.id);
%}

### 13. Guest reads booking A — retain the ETag
GET {{host}}/bookings/{{bookingAId}}
Authorization: Bearer {{guestToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Booking has ETag", function () { client.assert(!!response.headers.valueOf("ETag")); });
  if (response.status === 200) client.global.set("requestedETag", response.headers.valueOf("ETag"));
%}

### 14. Unchanged booking — 304
GET {{host}}/bookings/{{bookingAId}}
Authorization: Bearer {{guestToken}}
If-None-Match: {{requestedETag}}

> {%
  client.test("HTTP 304", function () { client.assert(response.status === 304, "Expected 304, got " + response.status); });
  client.test("No response body", function () { client.assert(!response.body); });
%}

### 15. Guest booking list — owner-filtered and paginated
GET {{host}}/bookings?page=0&size=5&sort=id,desc
Authorization: Bearer {{guestToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Five per API page", function () { client.assert(response.body.size === 5 && response.body.content.length <= 5); });
%}

### 16. Personal bookings include cancellation information
GET {{host}}/bookings/mine?page=0&size=5&sort=id,desc
Authorization: Bearer {{guestToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("New booking belongs to guest", function () {
    const booking = response.body.content.find(function (item) { return String(item.id) === String(client.global.get("bookingAId")); });
    client.assert(!!booking && booking.cancellable === true && !!booking.cancellationDeadline);
  });
%}

