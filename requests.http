### 26. Guest cancels B before its deadline
POST {{host}}/bookings/{{bookingBId}}/cancel
Authorization: Bearer {{guestToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Guest cancellation after confirmation", function () {
    client.assert(response.body.status === "CANCELLED" && response.body.guestCancelledAfterConfirmation === true);
    client.assert(!response.body._links.confirm && !response.body._links.seat && !response.body._links.cancel);
  });
%}

