### 10. Restaurant pagination — first page
GET {{host}}/restaurants?page=0&size=6&sort=id,asc
Authorization: Bearer {{guestToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("First page metadata", function () {
    client.assert(response.body.page === 0 && response.body.size === 6);
    client.assert(response.body.content.length <= 6);
    client.assert(response.body.totalElements >= 1);
  });
%}

