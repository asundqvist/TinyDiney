Accept: application/json

{
  "name": "Forbidden demo",
  "city": "Stockholm",
  "cuisine": "Family favourites",
  "seats": 30
}

> {%
  client.test("HTTP 403", function () { client.assert(response.status === 403, "Expected 403, got " + response.status); });
%}

### 07. Admin creates a demonstration restaurant — 201 + Location
POST {{host}}/restaurants
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "TinyDiney API Demo Cafe",
  "city": "Stockholm",
  "cuisine": "Pancakes and family favourites",
  "seats": 32
}

> {%
  client.test("HTTP 201", function () { client.assert(response.status === 201, "Expected 201, got " + response.status); });
  client.test("Created restaurant and Location", function () {
    client.assert(response.body.id > 0);
    client.assert(response.headers.valueOf("Location").endsWith("/restaurants/" + response.body.id));
  });
  if (response.status === 201) client.global.set("demoRestaurantId", response.body.id);
%}

### 08. Admin updates the restaurant — 200
PUT {{host}}/restaurants/{{demoRestaurantId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "name": "TinyDiney API Demo Cafe",
  "city": "Stockholm",
  "cuisine": "Pancakes and family favourites",
  "seats": 36
}

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Updated capacity", function () { client.assert(response.body.seats === 36); });
%}

