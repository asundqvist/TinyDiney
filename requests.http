### 19. Staff confirms A — 200; simulated confirmation notification
POST {{host}}/bookings/{{bookingAId}}/confirm
Authorization: Bearer {{staffToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Confirmed links", function () {
    client.assert(response.body.status === "CONFIRMED");
    client.assert(!!response.body._links.seat && !!response.body._links.cancel && !response.body._links.confirm);
  });
%}

### 20. Old ETag after status change — 200 and a different ETag
GET {{host}}/bookings/{{bookingAId}}
Authorization: Bearer {{guestToken}}
If-None-Match: {{requestedETag}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Representation changed", function () {
    client.assert(response.body.status === "CONFIRMED");
    client.assert(response.headers.valueOf("ETag") !== client.global.get("requestedETag"));
  });
%}

### 21. Confirming A again is illegal — 409 ProblemDetail
POST {{host}}/bookings/{{bookingAId}}/confirm
Authorization: Bearer {{staffToken}}

> {%
  client.test("HTTP 409", function () { client.assert(response.status === 409, "Expected 409, got " + response.status); });
  client.test("Conflict detail", function () { client.assert(response.body.status === 409 && !!response.body.detail); });
%}

### 22. Staff seats A — 200
POST {{host}}/bookings/{{bookingAId}}/seat
Authorization: Bearer {{staffToken}}
Accept: application/json

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Seated has no transitions", function () {
    client.assert(response.body.status === "SEATED");
    client.assert(!response.body._links.confirm && !response.body._links.seat && !response.body._links.cancel);
  });
%}

