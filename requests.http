### 37. Allowed frontend CORS preflight — no token
OPTIONS {{host}}/bookings
Origin: {{frontendOrigin}}
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

> {%
  client.test("HTTP 200", function () { client.assert(response.status === 200, "Expected 200, got " + response.status); });
  client.test("Exact origin, no cookie credentials", function () {
    client.assert(response.headers.valueOf("Access-Control-Allow-Origin") === request.environment.get("frontendOrigin"));
    client.assert(!response.headers.valueOf("Access-Control-Allow-Credentials"));
  });
%}

### 38. Unknown origin CORS preflight — 403
OPTIONS {{host}}/bookings
Origin: https://untrusted.example
Access-Control-Request-Method: POST
Access-Control-Request-Headers: authorization,content-type

> {%
  client.test("HTTP 403", function () { client.assert(response.status === 403, "Expected 403, got " + response.status); });
  client.test("Unknown origin not allowed", function () { client.assert(!response.headers.valueOf("Access-Control-Allow-Origin")); });
%}

# Additional manual checks:
# - With a second GUEST account, GET or cancel bookingAId/bookingBId -> 404.
# - An expired access token -> 401; a valid role without its scope -> 403.
# - Guest cancellation within one hour of a reservation -> 409 (time-dependent).
# - The full role/endpoint matrix and concurrent changes are exercised by mvn test.
