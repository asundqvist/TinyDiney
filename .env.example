VITE_AUTH0_DOMAIN=dev-1yqf3iatkam5h1bp.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://restaurant-api
VITE_AUTH0_ROLES_CLAIM=https://restaurant-api/roles
VITE_API_URL=http://localhost:8080

# Local MySQL. Use different, generated passwords in your own .env.
# These values are read by Docker Compose and Spring's mysql profile.
MYSQL_PORT=3306
DB_USERNAME=tinydiny
DB_PASSWORD=replace-with-a-long-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-local-password

# Add fictional demo restaurants on startup with the mysql profile.
DEMO_DATA_ENABLED=true
